note pemkey: stdin is an Ed25519 public key in PEM (SubjectPublicKeyInfo) followed by the same key as one
note line of hex. Decode the base64, check the 12-byte Ed25519 prefix (RFC 8410, OID 1.3.101.112), print the
note 32 key bytes as hex and compare them with the hex line.
note exit 0 the two forms agree, 1 they differ, 2 malformed
text tbeg "-----BEGIN"
text tend "-----END"
text tder "DER bytes "
text tpfx "Ed25519 SubjectPublicKeyInfo prefix: ok\n"
text tkey "key from PEM  "
text thex "key from hex  "
text tsame "the two forms agree: "
text yes "yes\n"
text no "no\n"
text vbad "verdict MALFORMED\n"
text nl "\n"
global der uchar 64
global pfx uchar 12
note b: 0 state (0 before BEGIN, 1 body, 2 after END), 1 bits, 2 nbits, 3 der count, 4 bad, 5 hex start, 6 hex end
global b ulong 7
fn setpfx to void
put pfx 0 48
put pfx 1 42
put pfx 2 48
put pfx 3 5
put pfx 4 6
put pfx 5 3
put pfx 6 43
put pfx 7 101
put pfx 8 112
put pfx 9 3
put pfx 10 33
put pfx 11 0
end
fn b64 c uchar to ulong
note value of a base64 character, 64 for padding, 65 for anything else
if and ge c 65 le c 90
ret ulong sub c 65
end
if and ge c 97 le c 122
ret add ulong sub c 97 26
end
if and ge c 48 le c 57
ret add ulong sub c 48 52
end
if eq c 43
ret 62
end
if eq c 47
ret 63
end
if eq c 61
ret 64
end
ret 65
end
fn push v ulong to void
acc = or shl get b 1 6 v
nb = add get b 2 6
if ge nb 8
nb = sub nb 8
n = get b 3
if lt n len der
put der n uchar and shr acc nb 255
put b 3 add n 1
else
put b 4 1
end
end
put b 1 and acc 255
put b 2 nb
end
fn body a ulong e ulong to void
for i ulong sub e a
v = b64 get inb add a i
if eq v 65
put b 4 1
end
if lt v 64
push v
end
end
end
fn oneline a ulong e ulong to void
s = get b 0
if sameb tbeg 0 a len tbeg
put b 0 1
else
if sameb tend 0 a len tend
put b 0 2
else
if eq s 1
body a e
end
if eq s 2
if lt a e
if eq get b 6 0
put b 5 a
put b 6 e
end
end
end
end
end
end
fn hexc v uchar to uchar
if lt v 10
ret add v 48
end
ret add v 87
end
fn cmpkey to bool
note print the key bytes as hex and compare with the hex line
h = get b 5
same = eq sub get b 6 h 64
ot tkey
for i ulong 32
x = get der add i 12
c1 = hexc shr x 4
c2 = hexc and x 15
oc c1
oc c2
if same
if ne c1 get inb add h mul i 2
same = false
end
if ne c2 get inb add h add mul i 2 1
same = false
end
end
end
ot nl
ot thex
oi h get b 6
ot nl
ret same
end
fn prefixok to bool
for i ulong 12
if ne get der i get pfx i
ret false
end
end
ret true
end
fn main to int
setpfx
r = rdall
if lt r 0
ret 2
end
n = ulong r
a = ulong 0
for i ulong n
if eq get inb i 10
oneline a i
a = add i 1
end
end
if lt a n
oneline a n
end
ot tder
on get b 3
ot nl
ok = eq get b 4 0
if ne get b 3 44
ok = false
end
if ok
ok = prefixok
end
if not ok
ot vbad
f = flush
ret 2
end
ot tpfx
same = cmpkey
ot tsame
v = int 1
if same
v = 0
ot yes
else
ot no
end
f = flush
ret v
end
